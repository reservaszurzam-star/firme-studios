# =============================================================================
# FIRME STUDIO — CONFIGURACIÓN DE SUPABASE & BACKEND
# =============================================================================

# 1. Credenciales de Supabase (Obtenlas en https://supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# 2. Clave de servicio opcional para operaciones administrativas del backend
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-opcional

# 3. Puerto del servidor Node/Express
PORT=3000
NODE_ENV=development
